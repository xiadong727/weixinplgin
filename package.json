{
  "name": "wx-typeset",
  "version": "2.1.0",
  "description": "公众号文章排版插件：Markdown 一键排版，支持在微信公众号后台直接排版或复制粘贴",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ext": "vite build --config vite.extension.config.ts",
    "build:all": "npm run build && npm run build:ext",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:core --silent && node --test \"test/*.test.mjs\"",
    "build:core": "vite build --config vite.core.config.ts",
    "gallery": "npm run build:core --silent && node scripts/make-gallery.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview --port 5273 --strictPort",
    "build:single": "npm run build --silent && node scripts/make-single.mjs",
    "pack": "npm run build:all --silent && npm run build:single --silent && npm run gallery --silent && node scripts/pack.mjs"
  },
  "type": "module",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
